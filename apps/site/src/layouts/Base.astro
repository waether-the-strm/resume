---
import "@strm/ui/index.css"
import themeInit from "@strm/ui/theme-init.js?raw"
import recursiveFont from "@strm/ui/fonts/recursive.woff2?url"
import { STRM_PRODUCTION } from "astro:env/server"
import { singleWithLocale } from "../i18n/content"
import { defaultLocale, launched, localePath, type Locale } from "../i18n/locales"
import { t } from "../i18n/ui"
import { withTrailingSlash } from "../lib/address"
import { emitsNoindex } from "../lib/indexing"
import { shareHeight, shareImagePath, shareWidth } from "../lib/share"
import { homeDocument, jsonLd, personFromCv, profileDocument } from "../lib/structured-data"

interface Props {
  title: string
  description?: string
  locale?: Locale
  /** The path of this page without a locale prefix. Set it to get hreflang alternates. */
  path?: string
}
const { title, description, locale = defaultLocale, path } = Astro.props
const noindex = emitsNoindex(Astro.url.pathname, STRM_PRODUCTION)
const absolute = (to: string) => new URL(to, Astro.site).href
// The host serves a folder index at the trailing-slash URL. See lib/address.ts.
const served = (forLocale: Locale, page: string) =>
  absolute(withTrailingSlash(localePath(forLocale, page)))
const canonical = path !== undefined ? served(locale, path) : undefined
const summary = description ?? t(locale, "site.description")
const siteName = t(locale, "site.title")
const shareImage = absolute(shareImagePath(locale))
const shareAlt = t(locale, "share.alt")
const structured = await structuredData()

async function structuredData(): Promise<string | undefined> {
  if (path !== "/" && path !== "/cv") return undefined
  if (!Astro.site) throw new Error("site is not configured")
  // One person. The CV entry exists in English; Polish shows that entry. Reading
  // English here keeps the facts and does not print a fallback for the home page.
  const cv = (await singleWithLocale("cv", defaultLocale)).data
  const person = personFromCv(cv, Astro.site.href)
  if (path === "/") {
    const home = served(locale, "/")
    if (!home) throw new Error("The home page has no canonical URL")
    return jsonLd(homeDocument(person, { name: siteName, url: home, inLanguage: locale }))
  }
  if (!canonical) throw new Error("The CV has no canonical URL")
  return jsonLd(profileDocument(person, canonical))
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={recursiveFont} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    {description && <meta name="description" content={description} />}
    {
      path !== undefined &&
        launched.map((other) => (
          <link rel="alternate" hreflang={other} href={served(other, path)} />
        ))
    }
    {
      path !== undefined && (
        <link rel="alternate" hreflang="x-default" href={served(defaultLocale, path)} />
      )
    }
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />
    {
      launched
        .filter((other) => other !== locale)
        .map((other) => <meta property="og:locale:alternate" content={other} />)
    }
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content={String(shareWidth)} />
    <meta property="og:image:height" content={String(shareHeight)} />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />
    {structured && <script is:inline type="application/ld+json" set:html={structured} />}
    <link rel="sitemap" type="application/xml" href={absolute("/sitemap-index.xml")} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline set:html={themeInit} />
  </head>
  <body>
    <slot />
    <script>
      import { prefetchItalicOnIntent } from "../scripts/prefetch-italic"
      prefetchItalicOnIntent()
    </script>
  </body>
</html>
