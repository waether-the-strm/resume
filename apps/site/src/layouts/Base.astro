---
import "@strm/ui/index.css"
import themeInit from "@strm/ui/theme-init.js?raw"
import { defaultLocale, launched, localePath, type Locale } from "../i18n/locales"
import { t } from "../i18n/ui"

interface Props {
  title: string
  description?: string
  locale?: Locale
  /** The path of this page without a locale prefix. Set it to get hreflang alternates. */
  path?: string
}
const { title, description, locale = defaultLocale, path } = Astro.props
const absolute = (to: string) => new URL(to, Astro.site).href
const canonical = absolute(path !== undefined ? localePath(locale, path) : Astro.url.pathname)
const summary = description ?? t(locale, "site.description")
const siteName = t(locale, "site.title")
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The rebuild is not the live site yet. Removed at v2.0.0. -->
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    {description && <meta name="description" content={description} />}
    {
      path !== undefined &&
        launched.map((other) => (
          <link rel="alternate" hreflang={other} href={absolute(localePath(other, path))} />
        ))
    }
    {
      path !== undefined && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={absolute(localePath(defaultLocale, path))}
        />
      )
    }
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />
    {
      launched
        .filter((other) => other !== locale)
        .map((other) => <meta property="og:locale:alternate" content={other} />)
    }
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <link rel="sitemap" type="application/xml" href={absolute("/sitemap-index.xml")} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline set:html={themeInit} />
  </head>
  <body>
    <slot />
  </body>
</html>
