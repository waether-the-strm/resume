---
// The message in its finished state: the look. One element per block; the engine later
// drives the same elements through the earlier scenes.
import { single } from "../i18n/content"
import type { Locale } from "../i18n/locales"
import Words from "./Words.astro"

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const message = await single("message", locale)
---

<div class="message" data-skin="look">
  <h1 class="type-display headline"><Words text={message.headline} locale={locale} /></h1>
  <p class="lead"><Words text={message.lead} locale={locale} /></p>
  <ol class="ui-tiles list">
    {
      message.list.map((item) => (
        <li>
          <Words text={item} locale={locale} />
        </li>
      ))
    }
  </ol>
  <div class="who">
    <hr class="ui-rule" />
    <p><Words text={message.who} locale={locale} /></p>
  </div>
  <p class="call">
    <span><Words text={message.call.text} locale={locale} /></span>
    <a class="ui-pill" href={message.call.action.href}>{message.call.action.label}</a>
  </p>
</div>

<style>
  /* two columns: the list beside the headline and the lead */
  .message {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 12px 64px;
    align-items: start;
    font-size: 17px;
    line-height: 1.55;
  }
  h1,
  p {
    margin: 0;
  }
  .headline {
    grid-column: 1;
    line-height: 1;
    margin-bottom: 10px;
  }
  .lead {
    grid-column: 1;
    max-width: 40ch;
    color: var(--ink-mute);
  }
  .list {
    grid-column: 2;
    grid-row: 1 / 3;
    margin-top: 6px;
  }
  .who {
    grid-column: 1 / -1;
    margin-top: 44px;
    font-size: 19px;
  }
  .who .ui-rule {
    margin-bottom: 18px;
  }
  .call {
    grid-column: 1 / -1;
    margin-top: 34px;
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
    color: var(--ink-mute);
    font-size: 16px;
  }

  @media (max-width: 760px) {
    .message {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
    .list {
      grid-column: 1;
      grid-row: auto;
    }
    .lead {
      max-width: none;
    }
    .who {
      margin-top: 22px;
    }
  }
</style>
