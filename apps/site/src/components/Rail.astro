---
// The rail: the stops as navigation (#34). Every stop is a button, rendered here on
// the server from the narrative, in the page's language. scripts/parts/rail.ts marks
// the chapter and the nearest stop; it does not build markup. Only the tour shows it
// (`html[data-tour]`, ADR 0009). A stop's mark sits left of its title as a faint badge;
// the ticks and dots carry nothing (ADR 0011). A title that is notation is marked as English.
import type { Locale } from "../i18n/locales"
import { narrative } from "../i18n/content"
import { t } from "../i18n/ui"
import { stopMark } from "../lib/stop-mark"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { stops } = await narrative(locale)
const railLabel = t(locale, "rail.label")
const previousStop = t(locale, "rail.previous")
const nextStop = t(locale, "rail.next")
---

<nav class="ui-rail" aria-label={railLabel}>
  <button type="button" class="ui-rail__arrow" data-dir="-1" aria-label={previousStop}></button>
  {
    stops.map((stop, index) => {
      const chapter = stop.chapter !== undefined
      return (
        <button
          type="button"
          class:list={["ui-rail__stop", chapter ? "is-chapter" : "is-dot"]}
          data-index={index}
          data-id={stop.id}
          aria-label={stop.name}
        >
          <span class="ui-rail__label">
            <span class="ui-badge" data-mark={stopMark(stops, index)} aria-hidden="true" />
            <span lang={stop.notation ? "en" : undefined}>{chapter ? stop.label : stop.name}</span>
          </span>
          {chapter ? (
            <span class="ui-rail__mark">
              <span class="ui-rail__tick" aria-hidden="true" />
            </span>
          ) : (
            <span class="ui-rail__dot" aria-hidden="true" />
          )}
        </button>
      )
    })
  }
  <button type="button" class="ui-rail__arrow" data-dir="1" aria-label={nextStop}></button>
</nav>
