---
// The blob: where the reader is, and a few controls (#35, ADR 0010, ADR 0012). Every word
// is rendered here, on the server. scripts/parts/blob.ts only marks which stop is current,
// whether the menu and the settings are open, and which value each setting shows.
import { narrative } from "../i18n/content"
import { launched, localeNames, localePath, type Locale } from "../i18n/locales"
import { t } from "../i18n/ui"
import { stopMark } from "../lib/stop-mark"
import { copyOptions } from "../scripts/copy-variant"

interface Props {
  locale: Locale
  /** Primitives page: sit in the flow instead of floating. */
  flow?: boolean
  /** Primitives page: rendered unfolded, so the two columns can be seen. */
  open?: boolean
  /** Primitives page: rendered with the settings strip unfolded as well. */
  settings?: boolean
  /**
   * The name row is folded. The home page leaves this set: without the tour the name
   * is already on the page. The script unfolds it when the tour says otherwise.
   */
  slim?: boolean
  /** Menu id, so two specimens on one page do not share it. */
  menuId?: string
  /** Replaces the landmark name, so two specimens on one page stay distinct. */
  labelledBy?: string
}
const {
  locale,
  flow = false,
  open = false,
  settings = false,
  slim = true,
  menuId = "blob-menu",
  labelledBy,
} = Astro.props
const story = await narrative(locale)
const last = story.stops.length - 1

// The name row's words live in ui.ts. The accessible name adds where the link goes,
// from the stops' `after`, so it is not a new sentence.
const signatureName = t(locale, "blob.name")
const signatureRest = t(locale, "blob.signature")
const signature = `${signatureName}${signatureRest}`
const nameLabel = `${signature}, ${story.after}`

const rootClass = ["blob", flow ? "is-flow" : ""].filter(Boolean).join(" ")
const blobClass = [
  "ui-blob",
  slim ? "is-slim" : "",
  open ? "is-open" : "",
  open && settings ? "is-settings" : "",
]
  .filter(Boolean)
  .join(" ")
const settingsId = `${menuId}-settings`
const settingsOpen = open && settings

// Language changes the address, so it is a link (ADR 0012): to the next launched language.
const next = launched[(launched.indexOf(locale) + 1) % launched.length] ?? locale
---

<!-- The landmark holds the blob and the tldr link beside it: both are the reader's controls. -->
<nav
  class={rootClass}
  aria-label={labelledBy ? undefined : t(locale, "blob.landmark")}
  aria-labelledby={labelledBy}
>
  <div class={blobClass} data-sound="on">
    <div class="ui-blob__menu" id={menuId} inert={!open}>
      <div class="ui-blob__menu-clip">
        <div class="ui-blob__grid">
          <button type="button" data-blob="start">
            <span>{t(locale, "blob.start")}</span>
            <span class="ui-blob__mark" aria-hidden="true">↑</span>
          </button>
          <a href="#work" data-blob="work">
            <span>{t(locale, "blob.work")}</span>
            <span class="ui-blob__mark" aria-hidden="true">↓</span>
          </a>
          <button
            type="button"
            class="ui-blob__more"
            data-blob="settings"
            aria-expanded={settingsOpen ? "true" : "false"}
            aria-controls={settingsId}
          >
            <span>{t(locale, "blob.settings")}</span>
            <span class="ui-blob__mark ui-blob__dots" aria-hidden="true">
              <svg viewBox="0 0 13 3">
                <circle cx="1.5" cy="1.5" r="1.25"></circle>
                <circle cx="6.5" cy="1.5" r="1.25"></circle>
                <circle cx="11.5" cy="1.5" r="1.25"></circle>
              </svg>
            </span>
          </button>
        </div>
        <div class="ui-blob__settings" id={settingsId} inert={!settingsOpen}>
          <div class="ui-blob__settings-clip">
            <div class="ui-blob__strip">
              <button type="button" data-blob="sound" aria-pressed="true">
                <span>{t(locale, "blob.sound")}</span>
                <span class="ui-blob__value">
                  <span class="is-on" data-v="on">{t(locale, "blob.on")}</span>
                  <span data-v="off">{t(locale, "blob.off")}</span>
                </span>
              </button>
              <button type="button" data-blob="theme">
                <span>{t(locale, "blob.theme")}</span>
                <span class="ui-blob__value">
                  <span class="is-on" data-v="system">{t(locale, "blob.theme.system")}</span>
                  <span data-v="light">{t(locale, "blob.theme.light")}</span>
                  <span data-v="dark">{t(locale, "blob.theme.dark")}</span>
                </span>
              </button>
              <a href={localePath(next)} hreflang={next} data-blob="language">
                <span>{t(locale, "blob.language")}</span>
                <span class="ui-blob__value">
                  <span class="is-on" lang={locale}>{localeNames[locale]}</span>
                </span>
                <span class="ui-blob__next" lang={next}>{localeNames[next]}</span>
              </a>
              <label data-blob="copy">
                <span>{t(locale, "blob.copy")}</span>
                <select>
                  {
                    copyOptions.map((option) => (
                      <option value={option.value}>{option.label}</option>
                    ))
                  }
                </select>
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>
    <button
      class="ui-blob__title"
      type="button"
      aria-expanded={open ? "true" : "false"}
      aria-controls={menuId}
      tabindex="-1"
    >
      <span class="ui-blob__stops">
        {
          story.stops.map((stop, index) => (
            <span
              class:list={["ui-blob__stop", index === last && "is-current"]}
              data-stop={index}
              data-first={index === 0 ? "true" : undefined}
            >
              <span
                class="ui-blob__num ui-badge"
                data-mark={stopMark(story.stops, index)}
                aria-hidden="true"
              />
              <span class="ui-blob__label" lang={stop.notation ? "en" : undefined}>
                {stop.name}
              </span>
            </span>
          ))
        }
        <span class="ui-blob__stop" data-stop="after">
          <span class="ui-blob__label">{story.after}</span>
        </span>
      </span>
      <span class="ui-blob__note" aria-hidden="true">
        <svg viewBox="0 0 9 14">
          <ellipse cx="2.9" cy="11.3" rx="2.9" ry="2.1" transform="rotate(-18 2.9 11.3)"></ellipse>
          <path d="M4.7 0.4h1.1c.1 1.7 2.9 2.5 2.9 5.3 0 .8-.2 1.6-.6 2.2.1-2-1-3-2.3-3.5v6.9H4.7z"
          ></path>
        </svg>
      </span>
    </button>
    <a class="ui-blob__id" href="#jan" aria-label={nameLabel} inert={slim}>
      <span class="ui-blob__id-clip">
        <span><b>{signatureName}</b>{signatureRest}</span>
        <span class="ui-blob__go" aria-hidden="true">→</span>
      </span>
    </a>
  </div>
  <a class="ui-blob__tldr" href="#jan" aria-label={t(locale, "blob.tldr.long")}>
    {t(locale, "blob.tldr")}
  </a>
</nav>

<style>
  .blob .ui-blob {
    position: fixed;
    z-index: 4;
    left: 0;
    right: 0;
    bottom: var(--blob-bottom);
    width: fit-content;
    max-width: calc(100vw - var(--blob-gutter));
    margin-inline: auto;
  }
  .blob .ui-blob__tldr {
    position: fixed;
    z-index: 4;
    right: var(--blob-tldr-right);
    bottom: var(--blob-tldr-bottom);
  }
  .blob.is-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-loose);
  }
  .blob.is-flow .ui-blob,
  .blob.is-flow .ui-blob__tldr {
    position: static;
  }
</style>

<style is:global>
  /*
    Until the script has marked a stop, the tour is at the start. The server's current
    stop is the last one, which is what the finished page (no tour) keeps.
  */
  html[data-tour] .ui-blob:not([data-current]) .ui-blob__stop {
    display: none;
  }
  html[data-tour] .ui-blob:not([data-current]) .ui-blob__stop[data-first] {
    display: flex;
  }
  html[data-tour] .ui-blob.is-slim:not([data-current]) .ui-blob__id {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
</style>
