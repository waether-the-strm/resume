---
// The home page in its finished state: the look, then the card and the work. This is what a
// reader without JavaScript, or with reduced motion, gets. The engine is a layer on top.
import Base from "../layouts/Base.astro"
import { launched, localeNames, localePath, type Locale } from "../i18n/locales"
import { narrative } from "../i18n/content"
import { t } from "../i18n/ui"
import Blob from "./Blob.astro"
import Card from "./Card.astro"
import Equation from "./Equation.astro"
import Message from "./Message.astro"
import Rail from "./Rail.astro"
import ThemeSwitch from "./ThemeSwitch.astro"
import Work from "./Work.astro"
import "../styles/tour.css"

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const story = await narrative(locale)
// What the tour needs to place the reader: the stops and the scene weights. Names stay in the
// markup, where they are text.
const track = {
  weights: story.weights,
  stops: story.stops.map(({ name: _name, label: _label, notation: _notation, ...stop }) => stop),
}
const length = story.stops.reduce((sum, stop) => sum + stop.travel + stop.hold, 0)
const scenes = [story.guide.scenes.words, story.guide.scenes.structure, story.guide.scenes.look]
---

<Base
  title={t(locale, "site.title")}
  description={t(locale, "site.description")}
  locale={locale}
  path="/"
>
  <!--
    Before the first paint: if the tour may run, say so, so the finished page does not flash
    before the first scene. If the tour's script never arrives, the page shows itself again.
  -->
  <script is:inline>
    ;(() => {
      const root = document.documentElement
      const motion = root.getAttribute("data-motion")
      const reduced =
        motion === "reduced" ||
        (motion !== "full" && matchMedia("(prefers-reduced-motion: reduce)").matches)
      if (reduced) return
      root.setAttribute("data-tour", "pending")
      setTimeout(() => {
        if (root.getAttribute("data-tour") === "pending") root.removeAttribute("data-tour")
      }, 4000)
    })()
  </script>
  <a class="skip" href="#jan">{t(locale, "nav.skip")}</a>
  <!-- The guide: one sentence per scene. Only the tour shows it. -->
  <p class="guide type-label" data-step="0">
    <span class="how" lang="en">{story.guide.label}</span>
    {
      scenes.map((text, index) => (
        <span class="step" data-for={index + 1}>
          <span class="n">{index + 1}</span>
          <span class="txt">
            {text}
            {index === 2 && <span class="pay">{story.guide.payoff}</span>}
          </span>
        </span>
      ))
    }
  </p>
  <Rail locale={locale} />
  <Blob locale={locale} />
  <main>
    <div
      class="track"
      style={`--track-length:${length.toFixed(3)}`}
      data-track={JSON.stringify(track)}
    >
      <section class="stage" aria-label={t(locale, "site.title")} data-scene="3">
        <Equation locale={locale} />
        <Message locale={locale} />
      </section>
    </div>
    <!--
      The exit's displacement map (#132, scenario G13): the prototype's #warp3. It holds no
      content and paints nothing; the message is bent through it only while the look is
      leaving. scripts/parts/exit.ts writes the scale, styles/exit.css applies the filter.
    -->
    <svg class="exit-map" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="exit-warp" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.006 0.024"
          numOctaves="2"
          seed="11"
          result="noise"></feTurbulence>
        <feDisplacementMap
          in="SourceGraphic"
          in2="noise"
          scale="0"
          xChannelSelector="R"
          yChannelSelector="G"></feDisplacementMap>
      </filter>
    </svg>
    <section class="jan" id="jan">
      <Card locale={locale} />
      <h2 class="type-micro work-heading" id="work">{t(locale, "work.heading")}</h2>
      <Work locale={locale} />
    </section>
  </main>
  <footer>
    <nav class="type-label languages" aria-label={t(locale, "nav.language")}>
      {
        launched.map((other) => (
          <a
            href={localePath(other)}
            lang={other}
            hreflang={other}
            aria-current={other === locale ? "true" : undefined}
          >
            {localeNames[other]}
          </a>
        ))
      }
    </nav>
    <ThemeSwitch locale={locale} />
  </footer>
</Base>

<script>
  import "../scripts/tour.ts"
</script>

<style>
  .exit-map {
    position: absolute;
  }
  .skip {
    position: absolute;
    left: var(--space-base);
    top: var(--space-base);
    translate: 0 -300%;
    padding: var(--space-tight) var(--space-snug);
    background: var(--paper-raised);
    color: var(--ink);
  }
  .skip:focus-visible {
    translate: 0;
  }
  main,
  footer {
    max-width: 1040px;
    margin: 0 auto;
    padding-inline: 40px;
  }
  .stage {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: 120px 60px;
  }
  .jan {
    display: grid;
    gap: 28px;
    padding-block: 150px 120px;
  }
  .work-heading {
    margin: var(--space-block) 0 0;
    color: var(--ink-mute);
    text-transform: uppercase;
  }
  footer {
    padding-block: 20px 80px;
  }
  .languages {
    display: flex;
    gap: var(--space-loose);
  }
  .languages a {
    color: var(--ink-mute);
    text-decoration: none;
    padding-block: var(--space-snug);
  }
  .languages a[aria-current] {
    color: var(--ink);
    border-bottom: 1px solid var(--accent);
  }

  @media (max-width: 760px) {
    main,
    footer {
      padding-inline: 20px;
    }
    .stage {
      padding-block: 96px 48px;
    }
    .jan {
      padding-block: 96px;
      gap: 24px;
    }
  }

  /*
   * A short phone. The prototype inset (118px / 88px) reserved a fixed guide
   * and a bottom control; neither is on the page. 64px / 32px is one step
   * down the space scale from the phone inset above, and it keeps the whole
   * stage inside a 664px viewport.
   */
  @media (max-width: 760px) and (max-height: 800px) {
    .stage {
      padding-block: 64px 32px;
    }
  }
</style>
