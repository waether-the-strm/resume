---
// strm-ui primitives, assembled by the same components the home page uses, with its real
// content. The layout around the primitives belongs to those components.
import Base from "../../layouts/Base.astro"
import Blob from "../../components/Blob.astro"
import Card from "../../components/Card.astro"
import Message from "../../components/Message.astro"
import Rail from "../../components/Rail.astro"
import Work from "../../components/Work.astro"
---

<Base title="strm-ui primitives">
  <main>
    <header class="top">
      <p class="type-micro kicker-nav"><a href="/ui/">strm-ui · tokens</a> · primitives</p>
      <h1 class="type-display">Primitives</h1>
      <p class="type-lead intro">
        The few parts the home page is made of, put together roughly the way it will use them. Token
        values are tuned here, on the assembled thing.
      </p>
      <div class="switches">
        <fieldset data-switch="theme">
          <legend class="type-micro">Theme</legend>
          <button type="button" data-value="" aria-pressed="true">auto</button>
          <button type="button" data-value="light" aria-pressed="false">light</button>
          <button type="button" data-value="dark" aria-pressed="false">dark</button>
        </fieldset>
      </div>
    </header>

    <section aria-labelledby="h-message">
      <h2 id="h-message" class="type-micro part">
        The message · ui-w · type-display · ui-tiles · ui-rule · ui-pill
      </h2>
      <Message locale="en" />
    </section>

    <section aria-labelledby="h-card">
      <h2 id="h-card" class="type-micro part">
        The card · ui-panel · ui-kicker · ui-mark · ui-paths
      </h2>
      <Card locale="en" />
    </section>

    <section aria-labelledby="h-work">
      <h2 id="h-work" class="type-micro part">The work · ui-work</h2>
      <Work locale="en" />
    </section>

    <section aria-labelledby="h-rail">
      <h2 id="h-rail" class="type-micro part">The rail · ui-rail</h2>
      <p class="type-lead intro">
        Chapter ticks with their chapter number, quiet dots between them, and two arrows. The tour
        hides it until it is on; this section sets that attribute so the primitive can be seen,
        fixed to the viewport the way the home page uses it.
      </p>
      <div class="specimen" data-tour="on">
        <Rail locale="en" />
      </div>
    </section>

    <section aria-labelledby="h-blob">
      <h2 id="h-blob" class="type-micro part">The blob · ui-blob</h2>
      <div class="blob-states">
        <div>
          <p id="blob-folded" class="state">Folded</p>
          <Blob locale="en" flow slim labelledBy="blob-folded" />
        </div>
        <div>
          <p id="blob-unfolded" class="state">Unfolded</p>
          <Blob
            locale="en"
            flow
            open
            slim={false}
            menuId="blob-menu-open"
            labelledBy="blob-unfolded"
          />
        </div>
        <div>
          <p id="blob-settings" class="state">Unfolded, with the settings</p>
          <Blob
            locale="en"
            flow
            open
            settings
            slim={false}
            menuId="blob-menu-settings-open"
            labelledBy="blob-settings"
          />
        </div>
      </div>
    </section>

    <section aria-labelledby="h-badge">
      <h2 id="h-badge" class="type-micro part">The badge · ui-badge</h2>
      <p class="type-lead intro">
        The mark to the left of a stop's title, in the rail and the blob. Decoration, quieter than
        the title: one character is a circle, three a short pill, and it never outweighs the title.
      </p>
      <ul class="badges">
        <li><span class="ui-badge" data-mark="0" aria-hidden="true"></span> w+w+w</li>
        <li><span class="ui-badge" data-mark="+" aria-hidden="true"></span> what?</li>
        <li><span class="ui-badge" data-mark="=" aria-hidden="true"></span> the equation</li>
        <li><span class="ui-badge" data-mark="1" aria-hidden="true"></span> the words</li>
        <li><span class="ui-badge" data-mark="2.3" aria-hidden="true"></span> tokens</li>
        <li><span class="ui-badge" data-mark="3.2" aria-hidden="true"></span> the look</li>
      </ul>
    </section>

    <section aria-labelledby="h-spark">
      <h2 id="h-spark" class="type-micro part">The spark · ui-spark</h2>
      <p class="type-lead intro">
        The glint where how? leaves the equation and where it lands in the guide's corner. A script
        adds it at a point, it plays once, and it removes itself. It carries no text and is hidden
        from assistive technology. Below, at its peak, and live.
      </p>
      <div class="sparks">
        <span class="still"><i class="ui-spark" aria-hidden="true"></i></span>
        <button type="button" class="again" data-spark-again>fire a pair</button>
      </div>
    </section>

    <section aria-labelledby="h-rule">
      <h2 id="h-rule" class="type-micro part">Rules · ui-rule · ui-rule is-strong</h2>
      <div class="rules">
        <hr class="ui-rule" />
        <hr class="ui-rule is-strong" />
      </div>
    </section>
  </main>
</Base>

<script>
  import { bindSwitches, createPrefs } from "../../lib/prefs"

  bindSwitches(createPrefs())

  // One chapter current, one stop nearest and just landed, so the states are visible here.
  document
    .querySelector<HTMLElement>('.specimen [data-id="structure"]')
    ?.setAttribute("aria-current", "true")
  document.querySelector(".specimen [data-id='tokens']")?.classList.add("is-nearest", "is-landed")

  // Fire a pair the way the home page does: one at the button, one a beat later to its right.
  document.querySelector<HTMLElement>("[data-spark-again]")?.addEventListener("click", (event) => {
    if (!(event.currentTarget instanceof HTMLElement)) return
    const box = event.currentTarget.getBoundingClientRect()
    for (const [late, x] of [
      [false, box.left - 40],
      [true, box.right + 40],
    ] as const) {
      const spark = document.createElement("i")
      spark.className = late ? "ui-spark is-late" : "ui-spark"
      spark.setAttribute("aria-hidden", "true")
      spark.style.setProperty("--spark-x", `${x}px`)
      spark.style.setProperty("--spark-y", `${box.top + box.height / 2}px`)
      spark.addEventListener("animationend", () => spark.remove(), { once: true })
      document.body.append(spark)
    }
  })
</script>

<style>
  main {
    max-width: 1040px;
    margin: 0 auto;
    padding: var(--space-page) var(--space-loose) var(--space-stage);
  }
  h1,
  h2,
  p {
    margin: 0;
  }

  .top {
    padding-bottom: var(--space-section);
  }
  .kicker-nav {
    color: var(--ink-mute);
    text-transform: uppercase;
    margin-bottom: var(--space-snug);
  }
  .intro {
    max-width: 44ch;
    margin-top: var(--space-base);
    color: var(--ink-mute);
  }
  .switches {
    margin-top: var(--space-block);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: var(--space-tight);
  }
  legend {
    float: left;
    padding: 0;
    margin-right: var(--space-snug);
    color: var(--ink-mute);
    text-transform: uppercase;
  }
  fieldset button {
    font: inherit;
    font-size: var(--type-label-size);
    font-variation-settings:
      "MONO" var(--voice-mono),
      "wght" 400;
    color: var(--ink-mute);
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: var(--space-tight) var(--space-hair);
    min-height: 44px;
    cursor: pointer;
  }
  fieldset button[aria-pressed="true"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  section {
    border-top: 1px solid var(--line);
    padding: var(--space-section) 0 var(--space-page);
  }
  .part {
    color: var(--ink-mute);
    text-transform: uppercase;
    margin-bottom: var(--space-section);
  }
  .badges {
    list-style: none;
    margin: var(--space-block) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-snug);
    justify-items: start;
    font-size: 13px;
    font-variation-settings:
      "MONO" var(--voice-mono),
      "wght" 400;
    color: var(--ink);
  }
  .badges li {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .sparks {
    display: flex;
    align-items: center;
    gap: var(--space-block);
    margin-top: var(--space-block);
  }
  .sparks .still {
    position: relative;
    width: 64px;
    height: 64px;
  }
  .sparks .still .ui-spark {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    animation: none;
    scale: var(--spark-peak);
  }
  .sparks .again {
    font: inherit;
    color: var(--ink);
    background: none;
    border: 1px solid var(--line);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  .rules {
    display: grid;
    gap: var(--space-block);
    max-width: 46ch;
  }
  .blob-states {
    display: grid;
    justify-items: start;
    gap: var(--space-block);
  }
  .state {
    color: var(--ink-mute);
    text-transform: uppercase;
    margin-bottom: var(--space-snug);
  }

  @media (max-width: 760px) {
    main {
      padding-inline: var(--space-base);
    }
  }
</style>
