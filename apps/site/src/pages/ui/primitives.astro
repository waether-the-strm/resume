---
// strm-ui primitives, assembled by the same components the home page uses, with its real
// content. The layout around the primitives belongs to those components.
import Base from "../../layouts/Base.astro"
import Card from "../../components/Card.astro"
import Message from "../../components/Message.astro"
import Work from "../../components/Work.astro"
---

<Base title="strm-ui primitives">
  <main>
    <header class="top">
      <p class="type-micro kicker-nav"><a href="/ui/">strm-ui · tokens</a> · primitives</p>
      <h1 class="type-display">Primitives</h1>
      <p class="type-lead intro">
        The few parts the home page is made of, put together roughly the way it will use them. Token
        values are tuned here, on the assembled thing.
      </p>
      <div class="switches">
        <fieldset data-switch="theme">
          <legend class="type-micro">Theme</legend>
          <button type="button" data-value="" aria-pressed="true">auto</button>
          <button type="button" data-value="light" aria-pressed="false">light</button>
          <button type="button" data-value="dark" aria-pressed="false">dark</button>
        </fieldset>
      </div>
    </header>

    <section aria-labelledby="h-message">
      <h2 id="h-message" class="type-micro part">
        The message · ui-w · type-display · ui-tiles · ui-rule · ui-pill
      </h2>
      <Message locale="en" />
    </section>

    <section aria-labelledby="h-card">
      <h2 id="h-card" class="type-micro part">
        The card · ui-panel · ui-kicker · ui-mark · ui-paths
      </h2>
      <Card locale="en" />
    </section>

    <section aria-labelledby="h-work">
      <h2 id="h-work" class="type-micro part">The work · ui-work</h2>
      <Work locale="en" />
    </section>

    <section aria-labelledby="h-rule">
      <h2 id="h-rule" class="type-micro part">Rules · ui-rule · ui-rule is-strong</h2>
      <div class="rules">
        <hr class="ui-rule" />
        <hr class="ui-rule is-strong" />
      </div>
    </section>
  </main>
</Base>

<script is:inline>
  ;(function () {
    var root = document.documentElement
    var group = document.querySelector('[data-switch="theme"]')
    function paint() {
      var current = root.getAttribute("data-theme") || ""
      group.querySelectorAll("button").forEach(function (button) {
        button.setAttribute("aria-pressed", String(button.dataset.value === current))
      })
    }
    group.addEventListener("click", function (event) {
      var button = event.target.closest("button")
      if (!button) return
      var next = button.dataset.value
      try {
        if (next) localStorage.setItem("strm-theme", next)
        else localStorage.removeItem("strm-theme")
      } catch (e) {}
      if (next) root.setAttribute("data-theme", next)
      else root.removeAttribute("data-theme")
      paint()
    })
    paint()
  })()
</script>

<style>
  main {
    max-width: 1040px;
    margin: 0 auto;
    padding: var(--space-page) var(--space-loose) var(--space-stage);
  }
  h1,
  h2,
  p {
    margin: 0;
  }

  .top {
    padding-bottom: var(--space-section);
  }
  .kicker-nav {
    color: var(--ink-mute);
    text-transform: uppercase;
    margin-bottom: var(--space-snug);
  }
  .intro {
    max-width: 44ch;
    margin-top: var(--space-base);
    color: var(--ink-mute);
  }
  .switches {
    margin-top: var(--space-block);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: var(--space-tight);
  }
  legend {
    float: left;
    padding: 0;
    margin-right: var(--space-snug);
    color: var(--ink-mute);
    text-transform: uppercase;
  }
  fieldset button {
    font: inherit;
    font-size: var(--type-label-size);
    font-variation-settings:
      "MONO" var(--voice-mono),
      "wght" 400;
    color: var(--ink-mute);
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: var(--space-tight) var(--space-hair);
    min-height: 44px;
    cursor: pointer;
  }
  fieldset button[aria-pressed="true"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  section {
    border-top: 1px solid var(--line);
    padding: var(--space-section) 0 var(--space-page);
  }
  .part {
    color: var(--ink-mute);
    text-transform: uppercase;
    margin-bottom: var(--space-section);
  }
  .rules {
    display: grid;
    gap: var(--space-block);
    max-width: 46ch;
  }

  @media (max-width: 760px) {
    main {
      padding-inline: var(--space-base);
    }
  }
</style>
