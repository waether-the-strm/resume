---
// strm-ui primitives, assembled the way the home page will use them. The copy is the
// prototype's; the layout around the primitives is this page's own and moves to the home
// page in phase 3.
import Base from "../../layouts/Base.astro"

const tiles = [
  "One idea per sentence.",
  "One clear place to look.",
  "Colour only where it means something.",
]
const work = [
  {
    title: "LetsReg sign-in",
    text: "I owned it from design to code: the flow, an animated background, and per-brand configuration in Storybook.",
  },
  {
    title: "GSR",
    text: "I took a reservation platform for public sports centres from product design to frontend, with its own design system.",
  },
  {
    title: "One design system, both products",
    text: "I set the tokens, components and skins that carried the Angular → React migration and a new self-service product.",
  },
]
---

<Base title="strm-ui primitives">
  <main>
    <header class="top">
      <p class="type-micro kicker-nav"><a href="/ui/">strm-ui · tokens</a> · primitives</p>
      <h1 class="type-display">Primitives</h1>
      <p class="type-lead intro">
        The few parts the home page is made of, put together roughly the way it will use them. Token
        values are tuned here, on the assembled thing.
      </p>
      <div class="switches">
        <fieldset data-switch="theme">
          <legend class="type-micro">Theme</legend>
          <button type="button" data-value="" aria-pressed="true">auto</button>
          <button type="button" data-value="light" aria-pressed="false">light</button>
          <button type="button" data-value="dark" aria-pressed="false">dark</button>
        </fieldset>
      </div>
    </header>

    <section aria-labelledby="h-message">
      <h2 id="h-message" class="type-micro part">
        The message · type-display · type-lead · ui-tiles · ui-rule · ui-pill
      </h2>
      <div class="message">
        <p class="type-display headline">
          Your product, <span class="accent">clear at a glance.</span>
        </p>
        <p class="lead">
          Visitors decide quickly whether a product is for them. I shape the page so they can.
        </p>
        <ol class="ui-tiles list">
          {tiles.map((tile) => <li>{tile}</li>)}
        </ol>
        <div class="who">
          <hr class="ui-rule" />
          <p>
            <strong>I'm Jan Mirecki,</strong> a design engineer: fifteen years designing for the web,
            eleven building it.
          </p>
        </div>
        <p class="call">
          <span>If you want your product to work like this</span>
          <a class="ui-pill" href="mailto:jan@strm.dev">write to me.</a>
        </p>
      </div>
    </section>

    <section aria-labelledby="h-card">
      <h2 id="h-card" class="type-micro part">
        The card · ui-panel · ui-kicker · ui-mark · ui-paths
      </h2>
      <div class="ui-panel card">
        <p class="ui-kicker">
          <span><b>=</b> how? · the same question, answered</span>
          <span class="ui-mark" aria-hidden="true">JM</span>
        </p>
        <div class="card-who">
          <p class="type-title card-name">
            I'm Jan, <span class="accent">a staff‑level design engineer.</span>
          </p>
          <p class="type-label role">15 years designing for the web · 11 building it · Oslo</p>
          <p class="sub">
            What you just scrolled through is how I work: I write the words, draw the structure,
            build the markup, keep the system, and only then pick the colour.
          </p>
        </div>
        <nav class="ui-paths" aria-label="Ways in">
          <a class="is-primary" href="mailto:jan@strm.dev">
            write to me <span>a role or a project</span>
          </a>
          <a href="#h-work">see the work <span>selected projects</span></a>
          <a class="is-soft" href="#h-card">or wander <span>notes and experiments, soon</span></a>
        </nav>
      </div>
    </section>

    <section aria-labelledby="h-work">
      <h2 id="h-work" class="type-micro part">The work · ui-work</h2>
      <ul class="ui-work">
        {
          work.map((item, index) => (
            <li>
              <div class={`ui-work__visual visual-${index + 1}`} />
              <div class="ui-work__text">
                <b>{item.title}</b>
                {item.text}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="h-rule">
      <h2 id="h-rule" class="type-micro part">Rules · ui-rule · ui-rule is-strong</h2>
      <div class="rules">
        <hr class="ui-rule" />
        <hr class="ui-rule is-strong" />
      </div>
    </section>
  </main>
</Base>

<script is:inline>
  ;(function () {
    var root = document.documentElement
    var group = document.querySelector('[data-switch="theme"]')
    function paint() {
      var current = root.getAttribute("data-theme") || ""
      group.querySelectorAll("button").forEach(function (button) {
        button.setAttribute("aria-pressed", String(button.dataset.value === current))
      })
    }
    group.addEventListener("click", function (event) {
      var button = event.target.closest("button")
      if (!button) return
      var next = button.dataset.value
      try {
        if (next) localStorage.setItem("strm-theme", next)
        else localStorage.removeItem("strm-theme")
      } catch (e) {}
      if (next) root.setAttribute("data-theme", next)
      else root.removeAttribute("data-theme")
      paint()
    })
    paint()
  })()
</script>

<style>
  main {
    max-width: 1040px;
    margin: 0 auto;
    padding: var(--space-page) var(--space-loose) var(--space-stage);
  }
  h1,
  h2,
  p {
    margin: 0;
  }

  .top {
    padding-bottom: var(--space-section);
  }
  .kicker-nav {
    color: var(--ink-mute);
    text-transform: uppercase;
    margin-bottom: var(--space-snug);
  }
  .intro {
    max-width: 44ch;
    margin-top: var(--space-base);
    color: var(--ink-mute);
  }
  .switches {
    margin-top: var(--space-block);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: var(--space-tight);
  }
  legend {
    float: left;
    padding: 0;
    margin-right: var(--space-snug);
    color: var(--ink-mute);
    text-transform: uppercase;
  }
  fieldset button {
    font: inherit;
    font-size: var(--type-label-size);
    font-variation-settings:
      "MONO" var(--voice-mono),
      "wght" 400;
    color: var(--ink-mute);
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: var(--space-tight) var(--space-hair);
    min-height: 44px;
    cursor: pointer;
  }
  fieldset button[aria-pressed="true"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  section {
    border-top: 1px solid var(--line);
    padding: var(--space-section) 0 var(--space-page);
  }
  .part {
    color: var(--ink-mute);
    text-transform: uppercase;
    margin-bottom: var(--space-section);
  }
  .accent {
    color: var(--accent);
  }

  /* the message: two columns, the list beside the headline and the lead */
  .message {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 12px 64px;
    align-items: start;
    font-size: 17px;
    line-height: 1.55;
  }
  .headline {
    grid-column: 1;
    line-height: 1;
    margin-bottom: 10px;
  }
  .lead {
    grid-column: 1;
    max-width: 40ch;
    color: var(--ink-mute);
  }
  .list {
    grid-column: 2;
    grid-row: 1 / 3;
    margin-top: 6px;
  }
  .who {
    grid-column: 1 / -1;
    margin-top: 44px;
    font-size: 19px;
  }
  .who .ui-rule {
    margin-bottom: 18px;
  }
  .who strong {
    font-weight: inherit;
    font-variation-settings:
      "MONO" var(--voice-sans),
      "wght" 800;
  }
  .call {
    grid-column: 1 / -1;
    margin-top: 34px;
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
    color: var(--ink-mute);
    font-size: 16px;
  }

  /* the card: who on the left, the ways in on the right */
  .card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 0 64px;
  }
  .card .ui-kicker {
    grid-column: 1 / -1;
    margin-bottom: 40px;
  }
  .card-name {
    line-height: 1.02;
    margin-bottom: 20px;
    font-variation-settings:
      "MONO" var(--voice-sans),
      "wght" 800;
  }
  .role {
    color: var(--ink-mute);
    margin-bottom: 28px;
  }
  .sub {
    max-width: 44ch;
    color: var(--ink-mute);
    line-height: 1.55;
  }
  .card .ui-paths {
    margin-top: -14px;
  }

  /* placeholder visuals; real screenshots or live fragments come with the project pages */
  .visual-1 {
    background: var(--accent-fill);
  }
  .visual-2 {
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 28px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 28px 100%,
      var(--paper);
  }
  .visual-3 {
    background: linear-gradient(
      90deg,
      var(--ink) 0 33.3%,
      var(--accent) 33.3% 66.6%,
      var(--paper-raised) 66.6%
    );
  }

  .rules {
    display: grid;
    gap: var(--space-block);
    max-width: 46ch;
  }

  @media (max-width: 900px) {
    .card {
      grid-template-columns: 1fr;
    }
    .card .ui-paths {
      margin-top: 36px;
    }
  }
  @media (max-width: 760px) {
    main {
      padding-inline: var(--space-base);
    }
    .message {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
    .list {
      grid-column: 1;
      grid-row: auto;
    }
    .lead {
      max-width: none;
    }
    .who {
      margin-top: 22px;
    }
    .card .ui-kicker {
      margin-bottom: 36px;
    }
    .card-name .accent {
      display: block;
    }
  }
</style>
