---
// Placeholder for the rebuild branch. The real home page arrives in phase 3
// (the static finished page) and phases 4-6 (the engine on top of it).
import Base from "../layouts/Base.astro"
---

<Base title="strm.dev v2, in progress">
  <main>
    <h1 class="type-title">strm.dev v2</h1>
    <p class="type-lead">The rebuild is in progress.</p>
    <p>
      The live site is <a href="https://strm.dev">strm.dev</a>. The design system so far is at <a
        href="/ui">/ui</a
      >.
    </p>
  </main>
</Base>

<style>
  main {
    max-width: 1040px;
    margin: 0 auto;
    padding: var(--space-stage) var(--space-loose);
  }
  h1 {
    margin: 0 0 var(--space-base);
  }
  p {
    margin: 0 0 var(--space-base);
    max-width: 56ch;
  }
</style>
