{
  "name": "strm-dev",
  "private": true,
  "type": "module",
  "version": "1.2.0",
  "scripts": {
    "dev": "pnpm --filter @strm/site dev",
    "build": "pnpm --filter @strm/site build",
    "preview": "pnpm --filter @strm/site preview",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "release-it"
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "prettier-plugin-astro": "0.14.1",
    "release-it": "19.0.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@10.34.9"
}
