---
import "../style/markdown.css"
import { Scripts } from "../components"
---

<!doctype html>
<html lang="en">
  <head>
    <Scripts.GTM />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>Jan Mirecki – Design Engineer</title>
  </head>
  <body class="md-body">
    <Scripts.GTMns />
    <nav
      class="sticky top-0 z-10 flex items-center justify-between gap-2 bg-[#111214] px-3 text-sm text-white sm:px-6 print:hidden"
      aria-label="Page"
    >
      <a href="/" class="inline-block px-2 py-3 text-white hover:underline">← Back</a>
      <div class="flex items-center gap-1 sm:gap-3">
        <a
          href="/Jan-Mirecki-CV-Design-Engineer.pdf"
          class="inline-block px-2 py-3 text-white hover:underline"
          download>Download PDF</a
        >
        <a href="javascript:window.print()" class="inline-block px-2 py-3 text-white hover:underline"
          >Print</a
        >
      </div>
    </nav>
    <main class="md-doc">
      <slot />
    </main>
    <Scripts.GA gtagId="G-GKB5E87E47" />
  </body>
</html>
